# CodeBuddy OpenAI 代理 - 环境变量配置
# 复制本文件为 .env 后填写真实值: copy .env.example .env (Windows) / cp .env.example .env

# ---- 代理服务 ----
PROXY_PORT=3000
PROXY_HOST=0.0.0.0
PROXY_API_KEY=codebuddy-proxy-key

# ---- 真实后端直连 (server-copilot.js 用) ----
# 从 TOKEN-DUMP 日志里复制你的 accessToken
COPILOT_TOKEN=
COPILOT_ENDPOINT=https://copilot.tencent.com/v2
# 实测可用一般为 hunyuan-2.0-instruct / auto, 其余模型按账号权限 (无权限会报 11102)
COPILOT_MODEL=hunyuan-2.0-instruct
# 可选透传头, JSON 字符串 (X-User-Id / X-Enterprise-Id 等, 有就填)
COPILOT_HEADERS={}

# ---- token 抓取补丁 (tools/patch-token-log.js 用) ----
# CodeBuddy 扩展宿主入口文件 (genie), 留空用默认安装路径
CODEBUDDY_EXT_INDEX=
# token 输出日志路径 (默认仓库根目录 token-dump.log, 已 gitignore)
TOKEN_DUMP_LOG=

# ---- 动态模型目录 (v2: 实时优先, 复刻 useCBModels/getDefaultModels) ----
MODELS_LIVE=1
MODELS_CHAT_MODE=craft
MODELS_TTL_MS=600000
# 实时失败时的静态回退: auto=自动找最新 main.*.chunk.js; off=跳过静态解析
MODELS_SOURCE=auto
MODELS_INCLUDE_DEPRECATED=false
MODELS_INCLUDE_DISABLED=false

# ---- IPC 版 (server-ipc.js 用): 本地 ACP agent 进程 ----
# 例: ACP_COMMAND="claude --acp" (换成你实际支持 ACP 的 agent 启动命令)
ACP_COMMAND=
ACP_ARGS=
ACP_CWD=
WORKSPACE_ROOT=
ALLOW_WRITE_OUTSIDE=0
# allow=自动批准工具/权限请求 | deny=拒绝
PERMISSION_POLICY=allow
